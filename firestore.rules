rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    function isCR() {
      return isAuthenticated() && getUserData().role == 'cr';
    }

    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }

    // Users Collection
    // Manageable user profiles for teacher, CRs, and students
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Settings Collection
    // Single-document settings e.g. /settings/classroom_settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Subjects Collection
    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Attendance Records Collection
    // Each record is keyed per student, date, and period (${date}_${period}_${studentId}).
    // Status can be present, absent, or leave.
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Append-Only Audit Logs Collection
    // Immutable audit entries recording who changed what, when, and reasons
    match /audit_logs/{auditId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // Requests Collection (Disputes, Leave / On-Duty, CR Correction Requests, and CR Role Approval Applications)
    match /requests/{requestId} {
      allow read: if true;
      
      allow create: if request.resource.data.studentId is string &&
                       request.resource.data.type in ['dispute', 'leave', 'cr_correction', 'correction', 'cr_approval'];

      allow update: if true;

      // Deletions permitted for classroom resets
      allow delete: if true;
    }

    // Protected Auth Secrets (Teacher access code storage)
    // Disallow all direct reads and writes from clients so secrets are never client-readable data
    match /auth_secrets/{secretId} {
      allow read, write: if false;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Timetable Collection
    // Master weekly classroom schedule across 8 periods
    match /timetable/{timetableId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
